# Copy to .env and `source .env` (or export in your shell) before starting.
# Without a key the app runs fully offline: heuristic scoring + template feedback.
ANTHROPIC_API_KEY=
ARTQUEST_MODEL=claude-opus-5
ARTQUEST_EFFORT=medium
ARTQUEST_SCORER=auto        # auto | claude | heuristic
ARTQUEST_FEEDBACK=auto      # auto | claude | template
ARTQUEST_SNAPSHOT_INTERVAL=45
ARTQUEST_DATA_DIR=./data
