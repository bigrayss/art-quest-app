# 复制成 .env。run.sh 会自动读；服务器上 systemd 用 EnvironmentFile 读。
# 注意：systemd 不认行尾注释，.env 里每行只能是 KEY=VALUE。
# 什么 key 都不填，应用照样完整地跑：启发式评分 + 模板反馈（陪伴也是模板版）。

# ---- 模型（二选一，都填则走 ecnu）----
# A. 华东师大 ecnu-plus（OpenAI 兼容；大陆服务器只有这条通）
ARTQUEST_LLM_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
ARTQUEST_LLM_API_KEY=
ARTQUEST_MODEL=ecnu-plus
# B. Anthropic（境外机器）
# ANTHROPIC_API_KEY=
# ARTQUEST_MODEL=claude-opus-5

# ARTQUEST_LLM_PROVIDER=openai|anthropic   不写就按给了哪个 key 自动选
# ARTQUEST_LLM_THINKING=0                  ecnu 的思维链；默认关，孩子等不了
# ARTQUEST_LLM_TIMEOUT=90                  秒
ARTQUEST_EFFORT=medium

# ---- 哪一路答 ----
ARTQUEST_SCORER=auto
ARTQUEST_FEEDBACK=auto
# auto：有 key 就用模型，没有就离线。也可以钉死：llm / heuristic（评分）、llm / template（反馈+陪伴）。

ARTQUEST_SNAPSHOT_INTERVAL=0
ARTQUEST_DATA_DIR=./data
ARTQUEST_ADMIN_TOKEN=
